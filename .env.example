# Copy this file to .env and fill in your own values. Never commit .env.
# Used only in PostgreSQL mode; CSV mode needs no configuration.
PGHOST=localhost
PGPORT=5432
PGDATABASE=inventory_dashboard
PGUSER=postgres
PGPASSWORD=root
PGSSLMODE=prefer

# Optional: a DISPOSABLE database for the PostgreSQL integration tests
# (the tests replace all data in its tables).
# TEST_PGHOST=localhost
# TEST_PGPORT=5432
# TEST_PGDATABASE=inventory_dashboard_test
# TEST_PGUSER=postgres
# TEST_PGPASSWORD=your_password_here

# Login (optional)
# AUTH_USERS_FILE=data/users.json      # where accounts (hashed passwords) are stored
# AUTH_SESSION_MINUTES=30              # sign out after this many idle minutes
